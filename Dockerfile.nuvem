# Tudo num só container (site + API), para hospedagens gratuitas de um serviço só (Render, Hugging Face Spaces...).
# O site escuta na porta $PORT (a hospedagem entrega ali) e repassa /api para a API em 127.0.0.1:8000.
FROM node:22-slim AS web-deps
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci

FROM node:22-slim AS web-build
WORKDIR /app
COPY --from=web-deps /app/node_modules ./node_modules
COPY web .
ENV NEXT_TELEMETRY_DISABLED=1 TOLARIS_API_URL=http://127.0.0.1:8000
RUN npm run build

FROM python:3.12-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 fonts-liberation \
 && rm -rf /var/lib/apt/lists/*
# Só o executável do Node: o Next em modo standalone leva suas próprias dependências
COPY --from=web-build /usr/local/bin/node /usr/local/bin/node

WORKDIR /app
COPY pyproject.toml alembic.ini ./
COPY src ./src
COPY migrations ./migrations
RUN pip install --no-cache-dir ".[api]"

COPY --from=web-build /app/.next/standalone ./web
COPY --from=web-build /app/.next/static ./web/.next/static
COPY --from=web-build /app/public ./web/public
COPY nuvem/iniciar.sh /app/iniciar.sh

RUN useradd --create-home tolaris && chown -R tolaris /app
USER tolaris
ENV TOLARIS_AMBIENTE=producao NEXT_TELEMETRY_DISABLED=1
CMD ["bash", "/app/iniciar.sh"]
