# Copie para .env e preencha. Nunca versione o .env.
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
TOLARIS_SECRET_KEY=
# true quando o site estiver atrás de HTTPS (produção)
TOLARIS_COOKIE_SECURE=false

# Endereço público do site (usado nos links de e-mail: senha, convite, portal)
TOLARIS_URL_PUBLICA=http://localhost:3000

# E-mail: console (não envia, só registra), arquivo (grava em TOLARIS_EMAIL_PASTA), smtp ou resend
TOLARIS_EMAIL_BACKEND=console
TOLARIS_EMAIL_REMETENTE=Tolaris Contábil <nao-responda@seudominio.com.br>
# SMTP
TOLARIS_SMTP_HOST=
TOLARIS_SMTP_PORTA=587
TOLARIS_SMTP_USUARIO=
TOLARIS_SMTP_SENHA=
# Resend (https://resend.com)
TOLARIS_RESEND_API_KEY=

# Leitura das caixas de e-mail de notas (IMAP). Em produção liga sozinha; use um único worker da API.
# TOLARIS_IMAP_AUTOMATICO=true
# TOLARIS_IMAP_INTERVALO_MINUTOS=10
